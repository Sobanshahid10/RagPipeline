{
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.pytest_cache",
    "backend/.venv",
    ".venv"
  ],
  "extraPaths": [
    "backend",
    "backend/app"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": false
}
