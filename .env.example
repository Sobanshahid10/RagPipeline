# Application Settings
PROJECT_NAME="Production RAG Engine"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + pgvector)
# For Docker Compose internal networking:
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@postgres:5432/rag_db
# For local host development (outside Docker):
# DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db

# Redis & Celery Configuration
# For Docker Compose internal networking:
REDIS_URL=redis://redis:6379/0
# For local host development (outside Docker):
# REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Step 11 / Gemini generation. Keep the real key in .env, which Git ignores.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
